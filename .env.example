# botadb environment — copy to .env (local) or set these on DigitalOcean.
# Never commit real values (.env is gitignored).

# PostgreSQL connection (DO Managed Database, payment project).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=

# Session signing secret for admin cookies + bot JWTs. Use a long random string.
JWT_SECRET=

# Shared API key the bots + botpro app send as x-api-key. Must match the key
# embedded in the bot's secret_config.py / botpro HttpReporter.
API_KEY=

# First admin account, seeded on `npm run seed`.
ADMIN_USER=
ADMIN_PASS=

# Set to "production" on DO so the admin cookie is marked Secure.
NODE_ENV=production

# Port (DO sets this automatically; default 3000 locally).
PORT=3000
